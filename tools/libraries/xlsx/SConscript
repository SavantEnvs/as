from building import *

CWD = GetCurrentDir()

objsXLT = Glob("xltester/*.cpp")
objsMain = Glob("utils/main.cpp")


def GetOpenXLSXPackage():
    """OpenXLSX v0.5.1 reads <c t="inlineStr"> (what Excel/WPS/openpyxl write
    for strings) and keeps the shared string table consistent, so the local
    source patch of v0.3.2 isn't needed anymore.

    cmake is only used to fetch the pugixml/miniz sources and to generate
    OpenXLSX-Exports.hpp; the library itself is built by SCons below.
    """
    pkg = Package(
        "https://github.com/troldal/OpenXLSX.git",
        dir="OpenXLSX-0.5.1",
        version="v0.5.1",
        cmd='cmake -S . -B build -G "Unix Makefiles" '
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_SHARED_LIBS=OFF "
        "-DOPENXLSX_BUILD_SAMPLES=OFF -DOPENXLSX_BUILD_TESTS=OFF",
    )
    return pkg


@register_library
class LibraryOpenXLSX(Library):
    def config(self):
        pkg = GetOpenXLSXPackage()
        deps = "%s/build/_deps" % (pkg)
        self.include = [
            "%s/OpenXLSX" % (pkg),
            "%s/OpenXLSX/headers" % (pkg),
            "%s/build/OpenXLSX" % (pkg),
            "%s/pugixml_fetch-src/src" % (deps),
            "%s/miniz_fetch-src" % (deps),
            # generated by cmake: miniz_export.h
            "%s/miniz_fetch-build" % (deps),
        ]
        self.Append(CXXFLAGS=["-std=gnu++17"])
        self.Append(CPPDEFINES=["OPENXLSX_STATIC_DEFINE", "MINIZ_STATIC_DEFINE"])
        self.source = PkgGlob(
            pkg,
            [
                "OpenXLSX/sources/*.cpp",
                "build/_deps/pugixml_fetch-src/src/pugixml.cpp",
                "build/_deps/miniz_fetch-src/miniz*.c",
            ],
        )


@register_library
class LibraryXLTester(Library):
    def config(self):
        self.include = ["%s/xltester" % (CWD)]
        self.Append(CXXFLAGS=["-std=gnu++17"])
        self.Append(CPPDEFINES=["OPENXLSX_STATIC_DEFINE"])
        self.LIBS = ["OpenXLSX", "AsOne"]
        self.source = objsXLT


@register_application
class ApplicationXLTester(Application):
    def config(self):
        self.LIBS = ["XLTester"]
        self.source = objsMain
        self.Install("../one")
